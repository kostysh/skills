{
  "$schema": "https://raw.githubusercontent.com/DavidAnson/vscode-markdownlint/main/markdownlint-cli2-config-schema.json",
  "gitignore": ".gitignore",
  "frontMatter": "(^---\\s*$[^]*?^---\\s*$)(\\r\\n|\\r|\\n|$)",
  "globs": [
    "**/*.md"
  ],
  "ignores": [
    ".docusaurus/**",
    "build/**",
    "node_modules/**"
  ],
  "config": {
    "default": true,
    "MD013": false,
    "MD033": false,
    "MD041": false
  }
}
